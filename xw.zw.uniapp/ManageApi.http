### 修改密码
###############################################获取卡片信息###############################################
GET {{baseUrl}}/api/BankCard/Gets
        ?sorts=id,
        &Page=1
        &PageSize=10
Authorization: Bearer {{token}}

### 获取银行卡详情信息
GET {{baseUrl}}/api/BankCard/GetCardContent?id=3
Authorization: Bearer {{token}}

### 提交卡片信息
POST {{baseUrl}}/api/BankCard/Post
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "Id": "0",
    "CardNum": "6888888881",
    "Bank": "0",
    "Email": "yymcct@qq.com",
    "Password": "123456123456123456",
    "Remark": "没有什么好备注的",
}
### 修改卡片信息
POST {{baseUrl}}/api/BankCard/Post
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

{
    "Id": "1",
    "CardNum": "201909060002",
    "Bank": "0",
    "Email": "yymcct@qq.com",
    "Password": "123456",
    "Remark": "没有什么好备注的",
}

### 删除卡片信息
GET {{baseUrl}}/api/BankCard/Delete?id=1
Authorization: Bearer {{token}}


### 获取个人银行卡汇总信息
GET {{baseUrl}}/api/BankCard/GetCardTotal
Authorization: Bearer {{token}}















