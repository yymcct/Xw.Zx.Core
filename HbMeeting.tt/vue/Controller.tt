using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using System.Net;
using System.IO;
using Microsoft.AspNetCore.Authorization;
using AutoMapper;
using Microsoft.Extensions.Logging;
using Sieve.Models;
using Xw.Zx.Core.Models.Model;
using Sieve.Services;
using Microsoft.EntityFrameworkCore;

namespace Xw.Zx.Core.Areas.Manager
{

    [ApiController]
    [Route("manager/[controller]/[action]")]
    [Authorize(Roles = "Admin")]
    public class <#= propertie #>Controller : ManagerBaseController
    {
        private readonly ILogger<<#= propertie #>Controller> _logger;

        public <#= propertie #>Controller(ILogger<<#= propertie #>Controller> logger
            , XwZxContext context
            , IMapper mapper
            , ISieveProcessor sieveProcessor) : base(context, mapper, sieveProcessor)
        {
            _logger = logger;
        }

        /// <summary>
        /// TODO
        /// </summary>
        /// <returns></returns>
        [HttpGet]
        public HbzsManagerResult<List<<#= propertieMDto#>>> Get<#= propertie #>s([FromQuery]SieveModel sieveModel)
        {
            try
            {
                var db = from <#= propertie.ToLower() #> in _context.<#= propertie #>s
                         join meeting in _context.Meetings on area.MeetingId equals meeting.Id
                         select new <#= propertieMDto#>
                         {
                            <#foreach (PropertyInfo p in property){ #>
                                <#=p.Name #> = <#= propertie.ToLower() #>.<#=p.Name #>,
                            <#}#>                             
                         };

                var list = _sieveProcessor.Apply(sieveModel, db).ToList();
                var total = _sieveProcessor.Apply(sieveModel, db, null, true, true, false).Count();
                return new HbzsManagerResult<List<<#= propertieMDto#>>>(list, total);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex.Message);
                return new HbzsManagerResult<List<<#= propertieMDto#>>>(HbzsManagerResultCode.Invalid_Error, ex.Message);
            }
        }
        /// <summary>
        /// TODO
        /// </summary>
        /// <param name="<#= propertieMDto.ToLower()#>"></param>
        /// <returns></returns>
        [HttpPost]
        public HbzsManagerResult Post<#= propertie #>([FromBody]Post<#= propertieMDto #> <#= propertieMDto.ToLower()#>)
        {
            try
            {
                if (<#= propertieMDto.ToLower()#>.Id == 0)
                {
                    Add<#= propertie #>(<#= propertieMDto.ToLower()#>);
                }
                else
                {
                    Update<#= propertie #>(<#= propertieMDto.ToLower()#>);
                }

                return new HbzsManagerResult(HbzsManagerResultCode.Sucess,"");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex.Message);
                return new HbzsManagerResult(HbzsManagerResultCode.Invalid_Error, ex.Message);
            }
        }

        /// <summary>
        /// TODO
        /// </summary>
        /// <param name="id"></param>
        /// <returns></returns>
        [HttpGet]
        public HbzsManagerResult Delete<#= propertie #>([FromQuery]int id)
        {
            try
            {
                var meetingarea = _context.<#= propertie #>s.Find(id);
                if (meetingarea != null)
                {
                    _context.<#= propertie #>s.Remove(meetingarea);
                    _context.SaveChanges();
                }
                return new HbzsManagerResult(HbzsManagerResultCode.Sucess, "");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex.Message);
                return new HbzsManagerResult(HbzsManagerResultCode.Invalid_Error, ex.Message);
            }
        }

        private void Add<#= propertie #>(Post<#= propertieMDto#> <#= propertieMDto.ToLower()#>)
        {
            var <#= propertie.ToLower() #> = new <#= propertie #>()
            {
               <#foreach (PropertyInfo p in property){ #>
                    <#=p.Name #> = <#= propertieMDto.ToLower() #>.<#=p.Name #>,
                <#}#>
            };

            _context.<#= propertie #>s.Add(<#= propertie.ToLower() #>);

            _context.SaveChanges();          
        }

        private void Update<#= propertie #>(Post<#= propertieMDto#> <#= propertieMDto.ToLower()#>)
        {
            var <#= propertie.ToLower() #> = _context.<#= propertie #>s.First(m => m.Id == <#= propertieMDto.ToLower()#>.Id);
            <#foreach (PropertyInfo p in property){ #>
                <#= propertie.ToLower() #>.<#=p.Name #> = <#= propertieMDto.ToLower() #>.<#=p.Name #>;
            <#}#>           
            
            _context.Entry(<#= propertie.ToLower() #>).State = EntityState.Modified;

            _context.SaveChanges();

        }
    }
}