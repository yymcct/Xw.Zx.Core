#############################################################QQ邮箱测试###################################################
### 获取邮件目录 第一页
GET https://w.mail.qq.com/cgi-bin/mail_list
    ?ef=js
    &r=0.4908667012315633
    &sid={{sid}}
    &t=mobile_data.json
    &s=list
    &cursor=max
    &cursorcount=20
    &folderid=1
    &device=android&app=phone&ver=app
Accept: , */*
Accept-Language: zh-Hans-CN,zh-Hans;q=0.8,en-US;q=0.5,en;q=0.3
Accept-Encoding: gzip, deflate
User-Agent: {{UserAgent}}
Host: w.mail.qq.com
Connection: Keep-Alive
Cookie: {{cookie}}


